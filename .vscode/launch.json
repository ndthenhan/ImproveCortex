{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Nucleo-F439ZI (Stable OpenOCD + ITM)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd", 

            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "device": "STM32F439ZI",
            "interface": "swd", // SWD is the default, but it's good to be explicit

            "serverpath": "D:/STM32/xpacks/@xpack-dev-tools/openocd/.content/bin/openocd.exe",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],

        "gdbTarget": "remote localhost:3333", // may not need this if openocd is configured to use the default port
        "svdFile": "${workspaceFolder}/STM32F439.svd",
        "runToEntryPoint": "main",

        "showDevDebugOutput": "raw",
        "preLaunchCommands": [
            "monitor reset halt"
        ],
        "postLaunchCommands": [
            "monitor reset run" 
        ],
        "swoConfig": {
            "enabled": true,
            "cpuFrequency": 168000000,
            "swoFrequency": 2000000,
            "source": "probe",
            "decoders": [
                {
                        "type": "console",
                        "port": 0,
                        "label": "ITM"
                    }
                ]
            }
        }
    ]
}